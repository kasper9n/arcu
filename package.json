{
  "main": "src/main.js",
  "scripts": {
    "dev": "npm run napi && DEBUG=true electron .",
    "dev-release": "npm run napi && electron .",
    "dev-nobuild": "electron .",
    "pack": "npm run napi && electron-builder --dir",
    "build": "npm run napi && electron-builder",
    "napi": "electron-build-env napi build --cargo-cwd ./native --release"
  },
  "devDependencies": {
    "electron": "^12.0.2",
    "electron-build-env": "^0.2.0",
    "electron-builder": "^22.10.5",
    "@napi-rs/cli": "^1.0.3"
  },
  "name": "arcu",
  "author": "kasper.space",
  "version": "1.0.0",
  "repository": "spectralkh/arcu",
  "build": {
    "appId": "space.kasper.arcu",
    "productName": "Arcu",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false,
        "LSUIElement": true
      }
    },
    "files": [
      "src",
      "native/index.node"
    ],
    "directories": {
      "buildResources": "build_resources",
      "output": "dist"
    }
  }
}
