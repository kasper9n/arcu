{
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build && DEBUG=true electron .",
    "start-nobuild": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build": "electron-build-env neon build --release"
  },
  "devDependencies": {
    "electron": "^6.1.5",
    "electron-build-env": "^0.2.0",
    "electron-builder": "^21.2.0",
    "neon-cli": "^0.3.3"
  },
  "name": "arcu",
  "author": "kasper.space",
  "version": "1.0.0",
  "repository": "spectralkh/arcu",
  "build": {
    "appId": "space.kasper.arcu",
    "productName": "Arcu",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "asar": false,
    "files": [
      "src",
      "native/index.node"
    ],
    "directories": {
      "buildResources": "build_resources",
      "output": "dist"
    }
  }
}
