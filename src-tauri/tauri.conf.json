{
  "build": {
    "distDir": "../build",
    "devPath": "http://localhost:7000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "package": {
    "productName": "Arcu"
  },
  "tauri": {
    "systemTray": {
      "iconPath": "./icons/icon.png"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "space.kasper.arcu",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "© 2023 kasper.space",
      "category": "Productivity",
      "shortDescription": "",
      "longDescription": "",
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.13",
        "exceptionDomain": "",
        "signingIdentity": null,
        "entitlements": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "updater": {
      "active": false
    },
    "allowlist": {
      "shell": {
        "open": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "security": {
      "csp": null
    }
  }
}
